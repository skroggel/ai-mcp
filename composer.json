{
    "name": "madj2k/ai-mcp",
    "type": "library",
    "description": "Framework-independent MCP client for Madj2k AI integrations.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "madj2k/ai-core": "^2.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Madj2k\\AiMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Madj2k\\AiMcp\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}
